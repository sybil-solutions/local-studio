{
	"$schema": "https://unpkg.com/wrangler@4/config-schema.json",
	"name": "local-studio-site-preview",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/fonts/*", "!/localai/*", "!/media/*"]
	},
	"observability": { "enabled": true },
	"env": {
		"production": {
			"name": "local-studio-site",
			"workers_dev": false,
			"routes": [
				{ "pattern": "localstudio.ai", "custom_domain": true },
				{ "pattern": "www.localstudio.ai", "custom_domain": true }
			]
		}
	}
}
