{
  "name": "localstudio-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "pnpm packages:check && tsc -b && vite build && node scripts/prerender.mjs && node scripts/stylex-check.mjs --dist",
    "lint": "eslint . && oxlint .",
    "generated:check": "node scripts/verify-generated.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "context:report": "node scripts/context.mjs report",
    "context:bundle": "node scripts/context.mjs bundle",
    "context:check": "node scripts/context.mjs check",
    "graph:report": "node scripts/graph.mjs report",
    "graph:check": "node scripts/graph.mjs check",
    "check": "pnpm lint && pnpm exec tsc -b && pnpm packages:check && pnpm context:check && pnpm graph:check && pnpm generated:check && pnpm stylex:check && pnpm test:unit",
    "design:manifest": "node --experimental-strip-types scripts/design-manifest.mjs write",
    "design:manifest:check": "node --experimental-strip-types scripts/design-manifest.mjs check",
    "reproducible:check": "node scripts/reproducible.mjs",
    "assets:manifest": "node scripts/assets.mjs write",
    "assets:check": "node scripts/assets.mjs check",
    "bundle:check": "node scripts/bundle.mjs check",
    "bundle:report": "node scripts/bundle.mjs report",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "index:html": "node --experimental-strip-types scripts/index-html.mjs write",
    "index:html:check": "node --experimental-strip-types scripts/index-html.mjs check",
    "packages:check": "pnpm --filter './packages/*' typecheck&&pnpm -C packages/logo-renderer shader:check",
    "logo:check": "pnpm --filter @local-ai/logo-renderer check",
    "stylex:check": "node scripts/stylex-check.mjs",
    "deploy:preview": "pnpm build && pnpm dlx wrangler@4.147.0 deploy",
    "deploy:production": "pnpm build && pnpm dlx wrangler@4.147.0 deploy --env production"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "@vgpu/wgsl": "0.3.1",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "1.62.1",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "oxlint": "1.78.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  }
}
