{
  "name": "local-studio",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "build:ui": "bun run --cwd apps/ui build",
    "build:bin": "bun run --cwd apps/controller build",
    "serve": "bun apps/controller/src/main.ts serve"
  }
}
