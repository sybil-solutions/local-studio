{
  "name": "@local-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local Studio desktop shell",
  "author": "Local Studio",
  "main": "main.cjs",
  "scripts": {
    "typecheck": "true",
    "release": "bash ../../scripts/release.sh",
    "dist:mac": "bash ../../scripts/release.sh && electron-builder --mac --arm64 --publish never",
    "dist:linux": "bash ../../scripts/release.sh && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  }
}
